# Copy to .env (gitignored). Every value is optional; the defaults run against local Ollama.

# LLM that writes the tests: ollama (default, local, free) | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
# Context window sent with every request (qwen3 needs >= 8192 for prompt + repair turns)
OLLAMA_NUM_CTX=16384
# qwen3 reasoning mode: slower; off by default
OLLAMA_THINK=false
LLM_TIMEOUT_S=300
LLM_RETRIES=2

# Only for LLM_PROVIDER=anthropic (uv sync --extra anthropic); default model claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only for LLM_PROVIDER=openai (uv sync --extra openai); set LLM_MODEL too
OPENAI_API_KEY=

# Pipeline options
# LTG_BASE_URL=https://www.saucedemo.com
# LTG_MAX_REPAIRS=2
# LTG_TEST_TIMEOUT_S=120
